    {
      "id": "211f9cce-0b9a-45e8-a08f-edad5167b71e",
      "name": "Calculate Hora Fin",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2.2,
      "position": [
        672,
        128
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst webhookData = $('Webhook').first().json.body;\nconst cliente = $('Get Cliente').first().json;\nconst servicio = $('Get Servicio').first().json;\n\nif (!cliente.id_cliente) return [{ json: { error: 'Cliente no encontrado' } }];\nif (!servicio.duracion) return [{ json: { error: 'Servicio no encontrado' } }];\n\nconst [h, m] = webhookData.hora.split(':').map(Number);\nconst totalMins = h * 60 + m + servicio.duracion;\n\nconst finH = Math.floor(totalMins / 60).toString().padStart(2, '0');\nconst finM = (totalMins % 60).toString().padStart(2, '0');\nconst hora_fin = `${finH}:${finM}`;\n\nreturn [{ json: {\n  id_cliente: cliente.id_cliente,\n  id_servicio: webhookData.id_servicio,\n  fecha: webhookData.fecha,\n  hora: webhookData.hora,\n  hora_fin: hora_fin,\n  observaciones: webhookData.observaciones || null\n} }];\n"
      }
    },
