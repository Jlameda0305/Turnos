        "query": "=INSERT INTO turnos (id_cliente, id_servicio, fecha, hora, hora_fin, observaciones, estado) VALUES ($1::uuid, $2::uuid, $3::date, $4::time, $5::time, $6, 'pendiente') RETURNING id_turno",
