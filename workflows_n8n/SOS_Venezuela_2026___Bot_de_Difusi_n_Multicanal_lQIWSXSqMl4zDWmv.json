      },
      "continueOnFail": true,
      "notes": "INSERT ... ON CONFLICT (person_id) DO NOTHING. Si la fila ya existe, no se inserta y el count de affected_rows = 0 \u2192 no publicar. Si affected_rows = 1 \u2192 es nuevo, publicar."
    },
