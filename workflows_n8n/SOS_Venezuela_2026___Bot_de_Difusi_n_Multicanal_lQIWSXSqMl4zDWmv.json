    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO sosve_published_log\n  (person_id, status, source_date, display_name, municipio, parroquia, hospital_name, photo_path)\nVALUES\n  (\n    '{{ $json.id }}',\n    '{{ $json.status }}',\n    {{ $json.source_date ? `'${$json.source_date}'` : 'NULL' }},\n    '{{ $json.display_name }}',\n    '{{ $json.municipio }}',\n    '{{ $json.parroquia }}',\n    '{{ $json.hospital_name }}',\n    '{{ $json.photo_path }}'\n  )\nON CONFLICT (person_id) DO NOTHING\nRETURNING\n  person_id,\n  status,\n  source_date,\n  display_name,\n  municipio,\n  parroquia,\n  hospital_name,\n  photo_path,\n  (xmax = 0) AS was_inserted",
        "options": {}
      },
      "id": "190e861d-2293-4731-9976-e9d71ab2273e",
