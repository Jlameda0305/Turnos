  "nodes": [
    {
      "parameters": {
        "jsCode": "// Normalizador de Payloads Omnicanal\nconst items = $input.all();\nconst normalized = [];\n\nfor (const item of items) {\n  const body = item.json.body || item.json;\n  \n  let canal = 'desconocido';\n  let sender_id = '';\n  let telefono = '';\n  let nombre_usuario = '';\n  let mensaje_texto = '';\n\n  // Telegram\n  if (body.message || body.callback_query) {\n    canal = 'telegram';\n    const msg = body.message || body.callback_query.message;\n    sender_id = String(msg.chat.id);\n    nombre_usuario = [msg.from.first_name, msg.from.last_name].filter(Boolean).join(' ');\n    mensaje_texto = body.callback_query ? body.callback_query.data : (msg.text || '');\n  } \n  // WhatsApp Meta Cloud API\n  else if (body.object === 'whatsapp_business_account' && body.entry) {\n    canal = 'whatsapp';\n    const entry = body.entry[0];\n    const changes = entry.changes[0];\n    const value = changes.value;\n    \n    if (item.json.query && item.json.query['hub.verify_token']) {\n      return [{ json: { challenge: item.json.query['hub.challenge'] } }];\n    }\n\n    if (value.messages && value.messages.length > 0) {\n      const waMsg = value.messages[0];\n      sender_id = waMsg.from;\n      telefono = '+' + waMsg.from;\n      nombre_usuario = value.contacts && value.contacts[0] ? value.contacts[0].profile.name : 'Usuario WhatsApp';\n      mensaje_texto = waMsg.type === 'text' ? waMsg.text.body : (waMsg.interactive?.button_reply?.id || waMsg.interactive?.list_reply?.id || '');\n    }\n  }\n\n  const session_id = `${canal}_${sender_id}`;\n\n  normalized.push({\n    json: {\n      session_id,\n      canal,\n      sender_id,\n      telefono,\n      nombre_usuario,\n      mensaje_texto,\n      timestamp: new Date().toISOString()\n    }\n  });\n}\n\nreturn normalized;"
      },
      "name": "Normalizador Omnicanal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
