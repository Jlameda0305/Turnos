    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\n        SELECT t.id_turno, t.fecha, t.hora, t.hora_fin, t.estado, t.observaciones,\n               s.nombre AS servicio_nombre, s.duracion, s.costo, ts.nombre AS tipo_nombre\n        FROM turnos t\n        JOIN servicios s ON t.id_servicio = s.id_servicio\n        JOIN tipos_servicio ts ON s.id_tipo_servicio = ts.id_tipo_servicio\n        JOIN clientes c ON t.id_cliente = c.id_cliente\n        WHERE c.id_cliente = $1::uuid\n        ORDER BY t.fecha DESC, t.hora DESC\n      ",
        "options": {
          "queryReplacement": "={{ $json.body.session_id }}"
        }
      },
      "id": "1aace31c-04e7-4af9-9097-86005b1657aa",
      "name": "Get Mis Turnos",
      "type": "n8n-nodes-base.postgres",
