    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE turnos \n              SET fecha=$1::date, hora=$2::time, hora_fin=$3::time, id_servicio=$4::uuid, estado=$5, observaciones=$6 \n              WHERE id_turno = $7::uuid",
        "options": {
          "queryReplacement": "={{ [$('Webhook').first().json.body.fecha, $('Webhook').first().json.body.hora, $('Calcular Hora Fin').first().json.hora_fin, $('Webhook').first().json.body.id_servicio, $('Webhook').first().json.body.estado, $('Webhook').first().json.body.observaciones, $('Webhook').first().json.body.id_turno] }}"
        }
      },
