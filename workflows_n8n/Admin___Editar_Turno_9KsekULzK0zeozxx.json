  "nodes": [
    {
      "parameters": {
        "httpMethod": "PATCH",
        "path": "admin/turno-editar",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "68ddc019-b338-4933-905a-e7abe72892b6",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        96
      ],
      "webhookId": "6163faff-d1fb-4afc-a87d-8a14be237bfd"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT duracion FROM servicios WHERE id_servicio = $1",
        "options": {
          "queryReplacement": "={{ [$('Webhook').first().json.body.id_servicio] }}"
        }
      },
      "id": "772b41d6-8c71-4fd0-b8b8-c880b2b7ea04",
      "name": "Get Servicio",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        96
      ],
      "credentials": {
        "postgres": {
          "id": "DI7VdrXRMXAIJibS",
          "name": "NFC_Turnos"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\n        const duracion = $input.item.json.duracion || 30;\n        const horaInicio = $('Webhook').first().json.body.hora;\n        \n        const [horas, min] = horaInicio.split(':').map(Number);\n        const totalMin = horas * 60 + min + duracion;\n        \n        const endHoras = Math.floor(totalMin / 60);\n        const endMin = totalMin % 60;\n        \n        const horaFin = `${endHoras.toString().padStart(2, '0')}:${endMin.toString().padStart(2, '0')}`;\n        \n        return { hora_fin: horaFin };\n      "
      },
      "id": "143c20df-5a45-4aaf-8899-c313c26a68db",
      "name": "Calcular Hora Fin",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*)::int as total \n              FROM turnos \n              WHERE fecha = $1::date \n                AND id_turno != $4::uuid\n                AND estado != 'cancelado'\n                AND ((hora >= $2::time AND hora < $3::time) \n                  OR (hora_fin > $2::time AND hora_fin <= $3::time) \n                  OR (hora <= $2::time AND hora_fin >= $3::time))",
        "options": {
          "queryReplacement": "={{ [$('Webhook').first().json.body.fecha, $('Webhook').first().json.body.hora, $json.hora_fin, $('Webhook').first().json.body.id_turno] }}"
        }
      },
      "id": "a1280a20-39c5-4b74-a4e6-36c2fd90d285",
      "name": "Check Colisiones",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        672,
        96
      ],
      "credentials": {
        "postgres": {
          "id": "DI7VdrXRMXAIJibS",
          "name": "NFC_Turnos"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "leftValue": "={{ $json.total > 0 }}",
              "operator": {
                "operation": "true",
                "type": "boolean"
              },
              "rightValue": true,
              "id": "51c98a68-f5d6-4f03-8af2-e6ef07e606fc"
            }
          ],
          "combinator": "and"
        },
        "options": {}
