      "name": "Get Admin Turnos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "\n        SELECT t.id_turno, t.fecha, t.hora, t.hora_fin, t.estado, t.observaciones, t.created_at,\n               c.nombre AS cliente_nombre, c.email AS cliente_email, c.telefono AS cliente_telefono,\n               s.nombre AS servicio_nombre, s.duracion, s.costo, ts.nombre AS tipo_nombre\n        FROM turnos t\n        JOIN servicios s ON t.id_servicio = s.id_servicio\n        JOIN tipos_servicio ts ON s.id_tipo_servicio = ts.id_tipo_servicio\n        JOIN clientes c ON t.id_cliente = c.id_cliente\n        ORDER BY t.fecha DESC, t.hora DESC\n      ",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "DI7VdrXRMXAIJibS",
          "name": "NFC_Turnos"
        }
      },
      "onError": "continueErrorOutput"
    },
