  "nodes": [
    {
      "parameters": {
        "path": "admin/turnos-v2",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "79e70cbe-dd0c-426c-9e4d-c21eb14090c8",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "webhookId": "7cd10aee-ca9e-4598-879f-91c09f47ed34"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.id_turno, t.fecha, t.hora, t.hora_fin, t.estado, t.observaciones, t.created_at,\n       c.nombre AS cliente_nombre, c.apellido AS cliente_apellido, c.dni AS cliente_dni, c.email AS cliente_email, c.telefono AS cliente_telefono,\n       s.nombre AS servicio_nombre, s.duracion, s.costo, ts.nombre AS tipo_nombre\nFROM turnos t\nJOIN servicios s ON t.id_servicio = s.id_servicio\nJOIN tipos_servicio ts ON s.id_tipo_servicio = ts.id_tipo_servicio\nJOIN clientes c ON t.id_cliente = c.id_cliente\nWHERE ($1::text = 'todos' OR t.estado::text = $1::text)\n  AND ($2::text IS NULL OR c.dni ILIKE '%' || $2::text || '%' OR c.nombre ILIKE '%' || $2::text || '%' OR c.apellido ILIKE '%' || $2::text || '%')\n  AND ($3::date IS NULL OR t.fecha >= $3::date)\n  AND ($4::date IS NULL OR t.fecha <= $4::date)\n  AND ($5::uuid IS NULL OR t.id_cliente = $5::uuid)\nORDER BY t.fecha DESC, t.hora DESC\nLIMIT $6 OFFSET $7",
        "options": {
          "queryReplacement": "={{ [$('Webhook').first().json.query?.estado || 'todos', $('Webhook').first().json.query?.search || null, $('Webhook').first().json.query?.fecha_inicio || null, $('Webhook').first().json.query?.fecha_fin || null, $('Webhook').first().json.query?.id_cliente || null, $('Webhook').first().json.query?.limit || 50, $('Webhook').first().json.query?.offset || 0] }}"
        }
      },
      "id": "96b43042-5a0c-4534-8743-7a50b6b25223",
      "name": "Get Admin Turnos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        0
      ],
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "DI7VdrXRMXAIJibS",
          "name": "NFC_Turnos"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*) as total\nFROM turnos t\nJOIN clientes c ON t.id_cliente = c.id_cliente\nWHERE ($1::text = 'todos' OR t.estado::text = $1::text)\n  AND ($2::text IS NULL OR c.dni ILIKE '%' || $2::text || '%' OR c.nombre ILIKE '%' || $2::text || '%' OR c.apellido ILIKE '%' || $2::text || '%')\n  AND ($3::date IS NULL OR t.fecha >= $3::date)\n  AND ($4::date IS NULL OR t.fecha <= $4::date)\n  AND ($5::uuid IS NULL OR t.id_cliente = $5::uuid)",
        "options": {
          "queryReplacement": "={{ [$('Webhook').first().json.query?.estado || 'todos', $('Webhook').first().json.query?.search || null, $('Webhook').first().json.query?.fecha_inicio || null, $('Webhook').first().json.query?.fecha_fin || null, $('Webhook').first().json.query?.id_cliente || null] }}"
        }
      },
      "id": "b72aa903-6c12-489d-9de2-8c3d59305cfc",
      "name": "Count Total",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        -16
      ],
      "credentials": {
        "postgres": {
          "id": "DI7VdrXRMXAIJibS",
          "name": "NFC_Turnos"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ data: $('Get Admin Turnos').all().map(i => i.json).filter(j => j.id_turno), total: parseInt($('Count Total').first().json.total) }) }}",
        "options": {}
      },
