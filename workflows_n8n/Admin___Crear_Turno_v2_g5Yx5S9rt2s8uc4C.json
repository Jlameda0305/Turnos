        }
      },
      "webhookId": "e802d4f3-d79c-44eb-86ad-bd6e76fadbb4"
    },
    {
      "id": "e380b816-4276-4e9d-b9e8-bea4aee55890",
      "name": "Get Servicio",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT duracion FROM servicios WHERE id_servicio = $1",
        "options": {
          "queryParameters": "={{ $json.body.id_servicio }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "DI7VdrXRMXAIJibS",
          "name": "NFC_Turnos"
        }
      }
    },
    {
      "id": "2264ed1d-2ff9-4d88-acd9-9f89f41fd7a3",
      "name": "Calcular Hora Fin",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "jsCode": "\n        const duracion = $input.item.json.duracion || 30;\n        const horaInicio = $('Webhook').first().json.body.hora;\n        \n        const [horas, min] = horaInicio.split(':').map(Number);\n        const totalMin = horas * 60 + min + duracion;\n        \n        const endHoras = Math.floor(totalMin / 60);\n        const endMin = totalMin % 60;\n        \n        const horaFin = `${endHoras.toString().padStart(2, '0')}:${endMin.toString().padStart(2, '0')}`;\n        \n        return { hora_fin: horaFin };\n      "
      }
    },
    {
      "id": "6775efa4-3a90-4839-9ad5-0dc1733cfe3f",
      "name": "Insertar Turno",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        672,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "\n        INSERT INTO turnos (id_cliente, id_servicio, fecha, hora, hora_fin, estado, observaciones)\n        VALUES ($1, $2, $3, $4, $5, $6, $7)\n        RETURNING id_turno;\n      ",
        "options": {
          "queryParameters": "={{ $('Webhook').first().json.body.id_cliente }},{{ $('Webhook').first().json.body.id_servicio }},{{ $('Webhook').first().json.body.fecha }},{{ $('Webhook').first().json.body.hora }},{{ $json.hora_fin }},{{ $('Webhook').first().json.body.estado }},{{ $('Webhook').first().json.body.observaciones }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "DI7VdrXRMXAIJibS",
          "name": "NFC_Turnos"
        }
      }
    },
    {
      "id": "38b14a61-b382-4d65-9961-046c36c22779",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        896,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ message: \"Turno creado correctamente\", id_turno: $json.id_turno }) }}",
        "options": {}
      }
    }
  ],
