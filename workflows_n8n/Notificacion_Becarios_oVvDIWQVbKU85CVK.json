    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  da.id AS datos_academicos_id,\n  da.becario_id,\n  da.estado_verificacion,\n  da.observaciones,\n  b.nombre,\n  b.apellido,\n  b.email,\n  COALESCE(n.estado_notificado::text, 'NINGUNO') AS ultimo_estado_notificado\nFROM datos_academicos da\nJOIN becarios b ON da.becario_id = b.id_usuario\nLEFT JOIN notificaciones_estado_enviadas n\n  ON n.datos_academicos_id = da.id\n  AND n.estado_notificado = (\n    SELECT ne2.estado_notificado\n    FROM notificaciones_estado_enviadas ne2\n    WHERE ne2.datos_academicos_id = da.id\n    ORDER BY ne2.fecha_envio DESC\n    LIMIT 1\n  )\nWHERE da.estado_verificacion IN ('APROBADO', 'PENDIENTE_MODIFICAR')\n  AND (\n    n.estado_notificado IS NULL\n    OR n.estado_notificado::text != da.estado_verificacion::text\n  );",
        "options": {}
      },
