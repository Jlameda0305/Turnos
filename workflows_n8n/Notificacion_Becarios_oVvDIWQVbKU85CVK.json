      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO notificaciones_estado_enviadas\n  (datos_academicos_id, estado_notificado, email_destinatario)\nVALUES\n  ({{ $('Switch Estado').item.json.datos_academicos_id }},\n   '{{ $('Switch Estado').item.json.estado_verificacion }}',\n   '{{ $('Switch Estado').item.json.email }}')\nON CONFLICT (datos_academicos_id, estado_notificado)\nDO UPDATE SET\n  fecha_envio = NOW(),\n  email_destinatario = EXCLUDED.email_destinatario;",
