    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*) as total FROM turnos WHERE ($1::text = 'todos' OR estado::text = $1::text);",
        "options": {
          "queryReplacement": "={{ $('Webhook').item.json.query.estado || 'todos' }}"
