    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.id_turno, t.fecha, t.hora, t.estado, t.observaciones, json_build_object('id_cliente', c.id_cliente, 'dni', c.dni, 'nombre', c.nombre, 'apellido', c.apellido) as cliente FROM turnos t JOIN clientes c ON t.id_cliente = c.id_cliente WHERE ($1::text = 'todos' OR t.estado::text = $1::text) ORDER BY t.fecha DESC, t.hora DESC LIMIT $2 OFFSET $3;",
        "options": {
          "queryReplacement": "={{ $('Webhook').item.json.query.estado || 'todos' }},{{ $('Webhook').item.json.query.limit || 10 }},{{ $('Webhook').item.json.query.offset || 0 }}"
        }
