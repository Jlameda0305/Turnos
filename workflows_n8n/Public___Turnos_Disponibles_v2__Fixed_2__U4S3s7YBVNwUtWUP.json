    {
      "parameters": {
        "jsCode": "const duracion = parseInt($('Get Servicio').first().json.duracion, 10);\nconst turnos = items.map(item => item.json);\nconst fecha = $('Webhook').first().json.body.fecha;\n\nif (!duracion) {\n  return [{ json: { error: 'Servicio no encontrado' } }];\n}\n\nfunction timeToMins(t) {\n  if (!t) return 0;\n  const [h, m] = t.split(':').map(Number);\n  return h * 60 + m;\n}\n\nconst occupiedRanges = turnos\n  .filter(t => t.hora && t.hora_fin)\n  .map(t => ({\n    start: timeToMins(t.hora),\n    end: timeToMins(t.hora_fin)\n  }));\n\nconst HORA_INICIO = 8 * 60; // 08:00\nconst HORA_FIN = 18 * 60; // 18:00\nconst INTERVALO = 30;\n\nconst availableSlots = [];\n\nfor (let start = HORA_INICIO; start < HORA_FIN; start += INTERVALO) {\n  const end = start + duracion;\n  \n  if (end > HORA_FIN) {\n    continue;\n  }\n  \n  const isOccupied = occupiedRanges.some(turn => {\n    return start < turn.end && end > turn.start;\n  });\n  \n  if (!isOccupied) {\n    const h = Math.floor(start / 60).toString().padStart(2, '0');\n    const m = (start % 60).toString().padStart(2, '0');\n    availableSlots.push(h + ':' + m);\n  }\n}\n\nreturn [{ json: { availableSlots, duracion, fecha } }];\n"
      },
