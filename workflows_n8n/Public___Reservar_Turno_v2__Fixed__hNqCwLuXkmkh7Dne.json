    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO turnos (id_cliente, id_servicio, fecha, hora, hora_fin, observaciones, estado) \nSELECT $1::uuid, $2::uuid, $3::date, $4::time, $5::time, $6, 'pendiente'\nWHERE NOT EXISTS (\n    SELECT 1 FROM turnos \n    WHERE fecha = $3::date \n      AND estado != 'cancelado'\n      AND hora < $5::time \n      AND hora_fin > $4::time\n)\nRETURNING id_turno;",
        "options": {
          "queryReplacement": "={{ $json.id_cliente }}, {{ $json.id_servicio }}, {{ $json.fecha }}, {{ $json.hora }}, {{ $json.hora_fin }}, {{ $json.observaciones }}"
        }
      },
      "id": "98ca2247-c7ed-4823-98a0-21dea4640a6e",
      "name": "Insert Turno",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        800,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "DI7VdrXRMXAIJibS",
          "name": "NFC_Turnos"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"success\": false, \"message\": \"No se pudo reservar el turno (horario no disponible o error de validaci\u00f3n).\" }",
        "options": {
          "responseCode": 400
        }
      },
      "id": "33fb6278-5295-45ec-9fba-6ffc9a77b12f",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        992,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "const webhookData = $('Webhook').first().json.body;\nconst cliente = $('Get Cliente').first().json;\nconst servicio = $('Get Servicio').first().json;\n\nif (!cliente.id_cliente) {\n  return [{ json: { error: 'Cliente no encontrado' } }];\n}\n\nif (!servicio.duracion) {\n  return [{ json: { error: 'Servicio no encontrado' } }];\n}\n\nconst [h, m] = webhookData.hora.split(':').map(Number);\nconst totalMins = h * 60 + m + parseInt(servicio.duracion, 10);\n\nconst finH = Math.floor(totalMins / 60).toString().padStart(2, '0');\nconst finM = (totalMins % 60).toString().padStart(2, '0');\nconst hora_fin = finH + ':' + finM;\n\nreturn [{\n  json: {\n    id_cliente: cliente.id_cliente,\n    id_servicio: webhookData.id_servicio,\n    fecha: webhookData.fecha,\n    hora: webhookData.hora,\n    hora_fin: hora_fin,\n    observaciones: webhookData.observaciones || null\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        0
      ],
      "id": "19c560b0-86fd-4714-9a55-7923e660029b",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, id_turno: $json.id_turno }) }}",
        "options": {
          "responseCode": 201
        }
      },
      "id": "f52e7de8-db63-4716-93c2-11f4245ecba4",
      "name": "Respond Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        992,
        -16
      ]
    }
  ],
