    {
      "id": "0fecfe22-c588-4013-95f0-cefb01811caa",
      "name": "Get Mis Turnos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "\n        SELECT t.id_turno, t.fecha, t.hora, t.hora_fin, t.estado, t.observaciones,\n               s.nombre AS servicio_nombre, s.duracion, s.costo, ts.nombre AS tipo_nombre\n        FROM turnos t\n        JOIN servicios s ON t.id_servicio = s.id_servicio\n        JOIN tipos_servicio ts ON s.id_tipo_servicio = ts.id_tipo_servicio\n        JOIN clientes c ON t.id_cliente = c.id_cliente\n        WHERE c.id_cliente = $1::uuid\n        ORDER BY t.fecha DESC, t.hora DESC\n      ",
        "options": {
          "queryReplacement": "={{ $json.body.session_id }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "DI7VdrXRMXAIJibS",
          "name": "NFC_Turnos"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "c1ca4dfb-687d-4ae0-b9f9-070f06630f62",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        448,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ turnos: $('Get Mis Turnos').all().map(i => i.json).filter(j => j.id_turno) }) }}",
        "options": {}
      }
    }
  ],
