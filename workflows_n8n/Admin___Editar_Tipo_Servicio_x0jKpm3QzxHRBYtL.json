        "query": "UPDATE tipos_servicio SET nombre = COALESCE(NULLIF($2, ''), nombre), descripcion = COALESCE(NULLIF($3, ''), descripcion), activo = CASE WHEN $4 = 'null' THEN activo WHEN $4 = 'true' THEN true ELSE false END WHERE id_tipo_servicio = $1::uuid RETURNING id_tipo_servicio, nombre, descripcion, activo",
